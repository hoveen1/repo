-- viewing the tables one last time to check if everything is in order
    
SELECT 
    *
FROM
    Customers;
    
SELECT 
    *
FROM
    Restaurants;
    
SELECT 
    *
FROM
    DeliveryPersonnel;
    
SELECT 
    *
FROM
    Orders;


-- i will create multiple views to export to Looker, to be used to visualize the insights gathered from the synthetic data

CREATE VIEW AverageOrderTotalPerCustomer AS
    SELECT 
        c.customer_id,
        c.customer_name,
        AVG(o.order_total) AS avg_order_total
    FROM
        Customers c
            JOIN
        Orders o ON c.customer_id = o.customer_id
    GROUP BY c.customer_id , c.customer_name
    ORDER BY avg_order_total DESC;
	
    -- creating a view to calculate average order total per restaurant
    
CREATE VIEW AverageOrderTotalPerRestaurant AS
    SELECT 
        r.restaurant_id,
        r.restaurant_name,
        r.cuisine_type,
        AVG(o.order_total) AS avg_order_total
    FROM
        Restaurants r
            JOIN
        Orders o ON r.restaurant_id = o.restaurant_id
    GROUP BY r.restaurant_id , r.restaurant_name , r.cuisine_type
    ORDER BY avg_order_total DESC;


-- creating a view to analyze the most popular cuisine type by counting the number of orders per cuisine

CREATE VIEW OrderCountPerCuisineType AS
    SELECT 
        r.cuisine_type, COUNT(o.order_id) AS order_count
    FROM
        Restaurants r
            JOIN
        Orders o ON r.restaurant_id = o.restaurant_id
    GROUP BY r.cuisine_type
    ORDER BY order_count DESC;
    
    
-- creating a view to calcuate the average order total per cuisiine which gives a different insight from order count per cuisine

CREATE VIEW AverageOrderTotalPerCuisine AS
    SELECT 
        r.cuisine_type, AVG(o.order_total) AS average_order_total
    FROM
        Restaurants r
            JOIN
        Orders o ON r.restaurant_id = o.restaurant_id
    GROUP BY r.cuisine_type
    ORDER BY average_order_total DESC;





